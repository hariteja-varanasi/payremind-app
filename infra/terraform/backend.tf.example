# Copy to backend.tf after creating the bucket once (versioning + SSE on), then `terraform init -migrate-state`.
terraform {
  backend "s3" {
    bucket       = "payremind-tfstate-<account-id>"
    key          = "beta/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
