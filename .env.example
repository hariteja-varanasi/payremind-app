PAYREMIND_DATABASE_URL=sqlite:///./payremind.db
PAYREMIND_WHATSAPP_TOKEN=
PAYREMIND_WHATSAPP_PHONE_NUMBER_ID=
PAYREMIND_WHATSAPP_APP_SECRET=
PAYREMIND_WHATSAPP_VERIFY_TOKEN=
PAYREMIND_PUBLIC_BASE_URL=http://localhost:8000
# Long random value in production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
PAYREMIND_SECRET_KEY=
# false only for local http development
PAYREMIND_COOKIE_SECURE=false
# Razorpay (our subscription fee). Create two monthly plans in the dashboard; amounts include GST.
PAYREMIND_RAZORPAY_KEY_ID=
PAYREMIND_RAZORPAY_KEY_SECRET=
PAYREMIND_RAZORPAY_WEBHOOK_SECRET=
PAYREMIND_RAZORPAY_PLAN_STARTER=
PAYREMIND_RAZORPAY_PLAN_GROWTH=
# Supplier on GST invoices. Leave GSTIN empty until registered (invoices then carry no GST).
PAYREMIND_SUPPLIER_NAME=PayRemind
PAYREMIND_SUPPLIER_GSTIN=
PAYREMIND_SUPPLIER_STATE_CODE=29
PAYREMIND_SUPPLIER_ADDRESS=
